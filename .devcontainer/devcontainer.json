{
  "name": "r3f-playground",
  "build": { 
    "dockerfile": "Dockerfile" 
  },
  "remoteUser": "node",
  "containerEnv": { "NEXT_TELEMETRY_DISABLED": "1" },
  "runArgs": ["--name=env-node-26-r3f", "--shm-size=1gb", "--security-opt=no-new-privileges"],
  "forwardPorts": [3000],
  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright"
      ]
    }
  }
}